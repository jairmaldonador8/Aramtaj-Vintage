# Copy to .env.local (never commit .env.local).

# Catalog source: local (data/products.json) or shopify
CATALOG_SOURCE=local

# Public URL of the site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sales WhatsApp: country code + number, digits only (e.g. 52 + 10 digits)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Pesos (MXN) display, server only and optional. The site fetches the daily USD→MXN rate
# (Frankfurter, ECB data); this value is only the fallback if that fails. Empty and no
# rate available = the USD/MXN switch is hidden and prices show in USD only.
USD_MXN_RATE=

# US launch list (server only): any JSON webhook (Zapier/Make, Klaviyo, Apps Script, Shopify Flow).
# Empty in local dev = sign-ups saved to .launch-list.local.jsonl (git-ignored).
LAUNCH_LIST_WEBHOOK_URL=

# Shopify (step 6, server only; only needed with CATALOG_SOURCE=shopify)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=
